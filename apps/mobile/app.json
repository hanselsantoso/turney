{
  "expo": {
    "name": "Turney",
    "slug": "turney",
    "scheme": "turney",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0d10",
    "splash": {
      "backgroundColor": "#0c0d10"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "id.turney.app" },
    "android": { "package": "id.turney.app" },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
